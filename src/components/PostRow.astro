---
import FormattedDate from "./FormattedDate.astro";
import { isRecent } from "../lib/utils";

interface Props {
  href: string;
  title: string;
  date: Date;
  category?: string;
}
const { href, title, date, category } = Astro.props;
const isNew = isRecent(date);
---

<a
  href={href}
  class="group grid grid-cols-[1fr_auto] items-baseline gap-x-4 gap-y-1 border-b border-line/60 py-3 transition-colors hover:bg-raised/30"
>
  <span class="flex min-w-0 items-baseline gap-2.5">
    <span class="text-accent transition-transform group-hover:translate-x-0.5" aria-hidden="true">▸</span>
    <span class="truncate text-ink transition-colors group-hover:text-accent">{title}</span>
    {
      isNew && (
        <span class="rounded bg-amber/15 px-1.5 py-0.5 text-[0.65rem] font-medium uppercase tracking-wide text-amber">
          new
        </span>
      )
    }
  </span>
  <span class="flex items-baseline gap-3 text-xs text-faint">
    {category && <span class="hidden text-faint/80 sm:inline">{category}</span>}
    <FormattedDate date={date} format="iso" class="tabular-nums" />
  </span>
</a>
