---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Tag from "../../components/Tag.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<"notes">;
}

const { note } = Astro.props;
const { Content } = await render(note);
const tags = note.data.tags ?? [];
---

<BaseLayout
  title={note.data.title ?? "Note"}
  type="article"
  publishedTime={note.data.date}
>
  <p class="prompt text-sm text-muted">
    <a href="/notes" class="tlink">cd ~/notes</a>
  </p>

  <article class="mt-6 reveal">
    <TerminalWindow title={`note · ${note.id}`} class="mx-auto max-w-3xl">
      <header class="mb-6 border-b border-line/70 pb-4">
        <p class="out text-xs text-faint">
          <FormattedDate date={note.data.date} format="human" />
        </p>
        {
          note.data.title && (
            <h1 class="mt-2 text-step-2 font-extrabold leading-tight text-ink">
              {note.data.title}
            </h1>
          )
        }
      </header>

      <div class="article">
        <Content />
      </div>

      {
        tags.length > 0 && (
          <footer class="mt-8 flex flex-wrap items-center gap-2 border-t border-line/70 pt-5">
            <span class="prompt text-xs text-muted">tags</span>
            {tags.map((t) => (
              <Tag tag={t} />
            ))}
          </footer>
        )
      }
    </TerminalWindow>
  </article>
</BaseLayout>
