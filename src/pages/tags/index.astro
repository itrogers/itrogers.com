---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import { kebab } from "../../lib/utils";

const posts = await getCollection("blog", ({ data }) => !data.draft);

// Gather + count tags, deduped by kebab(tag) while keeping a display label.
const byKey = new Map<string, { label: string; count: number }>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const trimmed = tag.trim();
    if (!trimmed) continue;
    const key = kebab(trimmed);
    if (!key) continue;
    const existing = byKey.get(key);
    if (existing) existing.count += 1;
    else byKey.set(key, { label: trimmed, count: 1 });
  }
}

// Count desc, then alpha by display label.
const tags = [...byKey.entries()]
  .map(([key, { label, count }]) => ({ key, label, count }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const totalTagged = tags.reduce((sum, t) => sum + t.count, 0);
---

<BaseLayout title="Tags" description="Browse Ian Rogers' writing by tag.">
  <section aria-labelledby="tags-h">
    <div class="mb-6 flex items-baseline justify-between border-b border-line pb-2">
      <h1 id="tags-h" class="prompt font-bold text-ink">
        <span class="text-accent">ls</span> ~/tags
      </h1>
      <p class="text-xs text-faint">
        {tags.length} tags · {totalTagged} refs
      </p>
    </div>

    {
      tags.length === 0 ? (
        <p class="out text-muted">no tags yet.</p>
      ) : (
        <TerminalWindow class="reveal" bodyClass="p-5 sm:p-6">
          <ul class="flex flex-wrap gap-2.5">
            {tags.map((t, i) => (
              <li class="reveal" style={`--d:${i + 1}`}>
                <a
                  href={`/tags/${t.key}`}
                  class="group inline-flex items-baseline gap-1.5 rounded border border-line bg-raised/40 px-2.5 py-1 text-sm text-muted transition-colors hover:border-accent hover:text-ink"
                >
                  <span>
                    <span class="text-faint group-hover:text-accent">#</span>{t.label}
                  </span>
                  <span class="text-xs text-faint tabular-nums group-hover:text-accent-dim">
                    ×{t.count}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </TerminalWindow>
      )
    }
  </section>
</BaseLayout>
