---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import PostRow from "../../components/PostRow.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const postSlug = (p: (typeof posts)[number]) => p.data.slug ?? p.id;

// group newest-first into descending years
const years = [
  ...new Set(posts.map((p) => p.data.date.getUTCFullYear())),
].sort((a, b) => b - a);

const byYear = years.map((year) => ({
  year,
  posts: posts.filter((p) => p.data.date.getUTCFullYear() === year),
}));
---

<BaseLayout
  title="Writing"
  description="Articles by Ian Rogers on software, the web, and building things."
>
  <!-- header: terminal session -->
  <TerminalWindow title="ian@itrogers: ~/writing — zsh" class="reveal">
    <p class="prompt text-sm text-muted reveal" style="--d:1">
      <span class="text-accent">ls</span> -lt ~/writing
    </p>
    <h1 class="out text-step-2 font-extrabold leading-tight text-ink reveal" style="--d:2">
      Writing
    </h1>
    <p class="max-w-prose pl-[1.4ch] leading-relaxed text-muted reveal" style="--d:3">
      Long-form notes on software, the web, and building things — written to
      document what I'm learning.
    </p>
    <p class="pl-[1.4ch] pt-2 text-sm text-faint reveal" style="--d:4">
      <span class="out">{posts.length} article{posts.length === 1 ? "" : "s"}, newest first</span>
    </p>
  </TerminalWindow>

  <!-- archive: grouped by year -->
  <div class="mt-14 space-y-12">
    {
      byYear.map((group, gi) => (
        <section class="reveal" style={`--d:${5 + gi}`} aria-labelledby={`y-${group.year}`}>
          <div class="mb-2 flex items-baseline justify-between border-b border-line pb-2">
            <h2 id={`y-${group.year}`} class="prompt font-bold text-ink">
              <span class="text-accent">ls</span> {group.year}/
            </h2>
            <span class="text-xs tabular-nums text-faint">
              {group.posts.length} file{group.posts.length === 1 ? "" : "s"}
            </span>
          </div>
          <div>
            {group.posts.map((p) => (
              <PostRow
                href={`/writing/${postSlug(p)}`}
                title={p.data.title}
                date={p.data.date}
                category={p.data.category}
              />
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <p class="mt-12 text-sm text-faint">
    <span class="out">
      end of archive — also available as <a href="/rss.xml" class="tlink">rss.xml</a>
    </span>
  </p>
</BaseLayout>
