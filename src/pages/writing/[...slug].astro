---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TerminalWindow from "../../components/TerminalWindow.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Tag from "../../components/Tag.astro";
import { readingMinutes } from "../../lib/utils";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );

  // newest-first list. "newer" = previous index (above), "older" = next index (below).
  return posts.map((post, i) => ({
    params: { slug: post.data.slug ?? post.id },
    props: {
      post,
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

type Entry = CollectionEntry<"blog">;
interface Props {
  post: Entry;
  newer: Entry | null;
  older: Entry | null;
}

const { post, newer, older } = Astro.props as Props;
const { Content } = await render(post);

const minutes = readingMinutes(post.body ?? "");
const tags = post.data.tags ?? [];
const slugOf = (p: Entry) => p.data.slug ?? p.id;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date}
>
  <!-- header / file metadata (mono) -->
  <header class="reveal">
    <p class="prompt text-sm text-faint" style="--d:0">
      <a href="/writing" class="tlink">cd ~/writing</a>
    </p>

    <h1 class="mt-5 text-step-2 font-bold text-ink reveal" style="--d:1">
      {post.data.title}
    </h1>

    <p
      class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-sm text-faint reveal"
      style="--d:2"
    >
      <FormattedDate date={post.data.date} format="human" />
      {
        post.data.category && (
          <>
            <span aria-hidden="true">·</span>
            <span>{post.data.category}</span>
          </>
        )
      }
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
    </p>

    {
      tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2 reveal" style="--d:3">
          {tags.map((t) => (
            <li>
              <Tag tag={t} />
            </li>
          ))}
        </ul>
      )
    }
  </header>

  <!-- long-form prose: the document you `cat` -->
  <article class="article mt-10 reveal" style="--d:4">
    <Content />
  </article>

  <!-- byline -->
  <div class="mt-16 border-t border-line pt-10">
    <TerminalWindow title="whoami" class="max-w-2xl">
      <div class="flex items-center gap-4">
        <img
          src="/media/ian-photo.jpg"
          alt="Ian Rogers"
          width="80"
          height="80"
          loading="lazy"
          class="h-20 w-20 shrink-0 rounded-lg border border-line object-cover grayscale-[0.15]"
        />
        <div class="min-w-0 space-y-1 text-sm">
          <p class="font-mono text-ink">Written by Ian Rogers</p>
          <p class="text-muted">
            entrepreneur &amp; software engineer in Las Vegas.
            <a href="/about" class="tlink">More about me →</a>
          </p>
          <p class="text-faint">
            <a
              href="https://twitter.com/itrogers"
              class="tlink"
              rel="me noopener"
            >
              @itrogers
            </a>
          </p>
        </div>
      </div>
    </TerminalWindow>
  </div>

  <!-- prev / next -->
  {
    (older || newer) && (
      <nav
        class="mt-12 grid gap-4 border-t border-line pt-6 sm:grid-cols-2"
        aria-label="More writing"
      >
        {older ? (
          <a href={`/writing/${slugOf(older)}`} class="group min-w-0">
            <span class="block font-mono text-xs text-faint">← older</span>
            <span class="mt-1 block truncate text-muted tlink">
              {older.data.title}
            </span>
          </a>
        ) : (
          <span aria-hidden="true" />
        )}
        {newer ? (
          <a
            href={`/writing/${slugOf(newer)}`}
            class="group min-w-0 sm:text-right"
          >
            <span class="block font-mono text-xs text-faint">newer →</span>
            <span class="mt-1 block truncate text-muted tlink">
              {newer.data.title}
            </span>
          </a>
        ) : (
          <span aria-hidden="true" />
        )}
      </nav>
    )
  }
</BaseLayout>
