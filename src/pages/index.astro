---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import TerminalWindow from "../components/TerminalWindow.astro";
import PostRow from "../components/PostRow.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Icon from "../components/Icon.astro";
import { STACK } from "../consts";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latestPosts = posts.slice(0, 5);

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latestNotes = notes.slice(0, 4);

const postSlug = (p: (typeof posts)[number]) => p.data.slug ?? p.id;
---

<BaseLayout>
  <!-- HERO: terminal session -->
  <section class="grid-bg -mx-5 px-5 pb-2 sm:-mx-8 sm:px-8">
    <TerminalWindow title="ian@itrogers: ~ — zsh" class="reveal mx-auto max-w-3xl">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
        <div class="min-w-0 flex-1 space-y-1.5 text-sm sm:text-base">
          <p class="prompt text-muted reveal" style="--d:1">
            <span class="text-accent">whoami</span>
          </p>
          <h1 class="out text-step-3 font-extrabold leading-tight text-ink reveal" style="--d:2">
            Ian Rogers
          </h1>
          <p class="pl-[1.4ch] text-faint reveal" style="--d:3">
            entrepreneur · engineer · writer · Las Vegas
          </p>

          <p class="prompt pt-5 text-muted reveal" style="--d:4">
            <span class="text-accent">cat</span> about.txt
          </p>
          <p class="max-w-prose pl-[1.4ch] leading-relaxed text-muted reveal" style="--d:5">
            My home on the web. I build software and businesses, and I write to
            document what I'm learning so it might help someone else.
          </p>

          <p class="prompt pt-5 text-muted reveal" style="--d:6">
            <span class="text-accent">cat</span> now.txt
          </p>
          <p class="pl-[1.4ch] text-muted reveal" style="--d:7">
            Building <a href="https://kohost.io" class="tlink">Kohost</a> &amp;
            <a href="https://mvestormedia.com" class="tlink">Mvestor Media</a>.
            <a href="/now" class="tlink">See what I'm focused on →</a>
            <span class="caret align-middle"></span>
          </p>
        </div>

        <img
          src="/media/ian-profile.jpg"
          alt="Ian Rogers"
          width="160"
          height="160"
          loading="eager"
          class="reveal hidden h-40 w-40 shrink-0 rounded-lg border border-line object-cover grayscale-[0.15] sm:block"
          style="--d:3"
        />
      </div>

      <!-- stack -->
      <div class="mt-7 border-t border-line/70 pt-5 reveal" style="--d:8">
        <p class="prompt mb-3 text-sm text-muted">
          <span class="text-accent">ls</span> ~/stack
        </p>
        <ul class="flex flex-wrap gap-2 pl-[1.4ch]">
          {
            STACK.map((s) => (
              <li class="flex items-center gap-2 rounded border border-line bg-raised/40 px-2.5 py-1 text-xs text-muted">
                <Icon name={s.icon} class="h-4 w-4" />
                {s.label}
              </li>
            ))
          }
        </ul>
      </div>
    </TerminalWindow>
  </section>

  <!-- WRITING + NOTES -->
  <div class="mt-20 grid gap-x-12 gap-y-16 lg:grid-cols-12">
    <section class="lg:col-span-7" aria-labelledby="writing-h">
      <div class="mb-3 flex items-baseline justify-between border-b border-line pb-2">
        <h2 id="writing-h" class="prompt font-bold text-ink">
          <span class="text-accent">ls</span> ~/writing
        </h2>
        <a href="/writing" class="tlink text-xs">all {posts.length} →</a>
      </div>
      <div>
        {
          latestPosts.map((p) => (
            <PostRow
              href={`/writing/${postSlug(p)}`}
              title={p.data.title}
              date={p.data.date}
              category={p.data.category}
            />
          ))
        }
      </div>
    </section>

    <section class="lg:col-span-5" aria-labelledby="notes-h">
      <div class="mb-3 flex items-baseline justify-between border-b border-line pb-2">
        <h2 id="notes-h" class="prompt font-bold text-ink">
          <span class="text-accent">tail</span> ~/notes
        </h2>
        <a href="/notes" class="tlink text-xs">stream →</a>
      </div>
      <ul class="space-y-5">
        {
          latestNotes.map((n) => (
            <li class="group">
              <a href={`/notes/${n.id}`} class="block">
                <FormattedDate
                  date={n.data.date}
                  format="iso"
                  class="text-xs text-faint"
                />
                <p class="mt-0.5 text-sm text-muted transition-colors group-hover:text-ink">
                  {n.data.title}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
